FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY main.py .
COPY onnx_models.py .

# Create models directory
RUN mkdir -p /models/triage /models/diagnosis /models/embeddings

# Copy models (if pre-downloaded)
# In production, models would be copied here or downloaded at runtime
# COPY models/ /models/

# Expose port
EXPOSE 8001

# Environment variables
ENV OFFLINE_MODE=true
ENV MODELS_DIR=/models
ENV PORT=8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8001/health')"

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
