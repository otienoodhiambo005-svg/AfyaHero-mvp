# ─────────────────────────────────────────────────────────────────────────────
# AfyaHero Hospital OS - Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core Infrastructure ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=your-session-secret-here
DATABASE_URL=postgresql://user:password@host:port/database
NEXT_PUBLIC_APP_URL=https://afyahero.com
SUPERADMIN_PUBLIC_APP_URL=https://superadmin.afyahero.com

# ─── AI Provider API Keys (Cascade Fallback) ───────────────────────────────────
# Primary: OpenRouter (aggregator)
OPENROUTER_API_KEY=sk-or-v1-...

# Secondary: Groq (fast, open-source)
GROQ_API_KEY=gsk_...

# Tertiary: HuggingFace (open-source)
HF_API_KEY=hf_...

# Paid Providers (for specific use cases)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
VERTEX_AI_STUDIO_API_KEY=AIzaSy...

# ─── AI Microservices URLs ────────────────────────────────────────────────────
# For local development (change to production URLs in production)
TRIAGE_SERVICE_URL=http://localhost:8001
DIAGNOSIS_SERVICE_URL=http://localhost:8002
IMAGING_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004
OPERATIONAL_SERVICE_URL=http://localhost:8005
PHARMACY_SERVICE_URL=http://localhost:8006
ORCHESTRATION_SERVICE_URL=http://localhost:8007
HL7_GATEWAY_URL=http://localhost:8008

# ─── Redis (Upstash) for Rate Limiting & Caching ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Google Cloud Services ───────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
HEALTHCARE_DATASET_ID=your-dataset-id
DICOM_STORE_ID=your-dicom-store-id

# ─── Telehealth Services (Google Meet) ─────────────────────────────────────────
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary@your-project.iam.gserviceaccount.com

# ─── Twilio (SMS/WhatsApp/Voice) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_PHONE_NUMBER=whatsapp:+14155238886

# ─── AI Speech Services ───────────────────────────────────────────────────────
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus
COQUI_API_KEY=your-coqui-api-key

# ─── Third-party APIs ─────────────────────────────────────────────────────────
DRUGBANK_API_KEY=your-drugbank-api-key

# ─── Payment Services ─────────────────────────────────────────────────────────
MPESA_API_KEY=your-mpesa-api-key
SHIF_API_KEY=your-shif-api-key

# ─── Development Settings ────────────────────────────────────────────────────
NODE_ENV=development
ENABLE_DEMO_LOGIN=true
# Required in production-like environments when ENABLE_DEMO_LOGIN=true
DEMO_PASSWORD_HASH=scrypt$<salt_hex>$<hash_hex>
