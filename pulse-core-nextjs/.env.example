# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── SECRETS (Must be stored in secrets manager, not in .env files) ──────────
# These values MUST be rotated and stored in a secrets manager:
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_JWT_SECRET
# - SUPABASE_DB_PASSWORD
# - SESSION_SECRET (generate with: openssl rand -base64 32)

# ─── OPTIONAL AI PROVIDERS ───────────────────────────────────────────────────
# Only configure the providers you intend to use
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# HF_API_KEY=

# ─── VERTEX AI STUDIO (Google Cloud) ────────────────────────────────────────
# Used as fallback when primary AI routes fail, and for translation API
# VERTEX_AI_STUDIO_API_KEY=

# ─── OPTIONAL REDIS (Rate Limiting) ──────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# TEST_RATE_LIMIT_OVERRIDE_ENABLED=0

# ─── SESSION & AUTHENTICATION ────────────────────────────────────────────────
# SESSION_SECRET=<generate-32-random-bytes-base64>
SESSION_INACTIVITY_TIMEOUT_MINUTES=20
SESSION_LOGIN_MAX_ATTEMPTS=5
SESSION_LOGIN_WINDOW_MINUTES=15
# DEMO_PASSWORD=<set-strong-password-if-enabled>

# App-to-app Developer API auth (v1)
# Access token TTL: 15 minutes; Refresh token TTL: 7 days
# AFYAHERO_V1_APP_TOKEN_SECRET=<store-in-secrets-manager; minimum-32-characters>
# AFYAHERO_DEVELOPER_APPS_JSON=[{"appId":"patient-mobile-app","appKey":"replace_with_app_key","signingSecret":"replace_with_signing_secret","hospitalId":"hospital_123","appType":"patient_app","scopes":["fhir:read"]}]

# ─── AI CONSENT & PATIENT DATA PRIVACY ───────────────────────────────────────
AI_CONSENT_MODE=opt-in
AI_ANONYMIZATION_LEVEL=full
AUDIT_LOGGING_ENABLED=true

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
# Set to false in production
ENABLE_DEMO_LOGIN=false
# Required outside development if demo login is enabled.
# Generate with: node -e "const c=require('crypto');const salt='afyahero-demo-auth-v1';const hash=c.scryptSync(process.argv[1],salt,64).toString('hex');console.log(`scrypt$${Buffer.from(salt).toString('hex')}$${hash}`)" "YourStrongDemoPassword"
# DEMO_PASSWORD_HASH=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_USER=

# Standalone portal mode:
# AFYAHERO_APP_MODE=superadmin
# In superadmin mode, non-superadmin portal/auth/api routes are blocked or redirected.

# ─── EMAIL SERVICE (ZeptoMail) ───────────────────────────────────────────────
# EMAIL_SMTP_HOST=smtp.zeptomail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=emailapikey
# EMAIL_SMTP_PASS=<store-in-secrets-manager>
# EMAIL_FROM=noreply@yourdomain.com
# ZEPTOMAIL_API_HOST=api.zeptomail.com
# ZEPTOMAIL_AGENT_ALIAS=

# ─── DHA AFYALINK INTEGRATION ───────────────────────────────────────────────
# All AfyaLink credentials MUST be stored in secrets manager
# AFYALINK_ENVIRONMENT=UAT
# AFYALINK_BASE_URL=https://uat.dha.go.ke
# AFYALINK_AGENT_ID=
# AFYALINK_BASIC_USERNAME=
# AFYALINK_BASIC_PASSWORD=
# AFYALINK_TOKEN_KEY=
# AFYALINK_TOKEN_SECRET=
# AFYALINK_CALLBACK_URL=
# AFYALINK_VALIDATE_URL=
# AFYALINK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AFYALINK_PRIVATE_KEY=<store-in-secrets-manager>

# ─── AFRICA'S TALKING (WhatsApp & USSD Bot) ───────────────────────────────
# Africa's Talking API credentials for WhatsApp and USSD integration
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# WHATSAPP_SENDER_ID=AfyaHero
# HMAC verification for inbound bot webhooks (generate with: openssl rand -hex 32)
# USSD_WEBHOOK_SECRET=
# WHATSAPP_WEBHOOK_SECRET=

# ─── GDPR DATA RETENTION CRON ───────────────────────────────────────────────
# Bearer secret for POST /api/cron/data-retention (scheduled job / GitHub Actions)
# DATA_RETENTION_CRON_SECRET=

# ─── SUPERADMIN AI COST MONITORING ──────────────────────────────────────────
# Optional monthly budget cap (USD) for AI cost trend alerts on superadmin portal
# AI_MONTHLY_BUDGET_USD=500

# ─── SECURITY NOTES ──────────────────────────────────────────────────────────
# 1. Never commit actual secrets to version control
# 2. Use a secrets manager (Azure Key Vault, AWS Secrets Manager, HashiCorp Vault)
# 3. Rotate all keys regularly (minimum every 90 days)
# 4. Use environment-specific values for production/staging/development
# 5. Generate SESSION_SECRET with: openssl rand -base64 32
