{
    "name": "AfyaHero",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:superadmin": "node scripts/run-superadmin-mode.mjs dev",
        "build": "next build",
        "build:superadmin": "node scripts/run-superadmin-mode.mjs build",
        "start": "next start",
        "start:superadmin": "node scripts/run-superadmin-mode.mjs start",
        "docker:build": "docker build -t afyahero-web:latest .",
        "docker:check": "node scripts/check-containerization.mjs",
        "docker:up": "docker compose up --build -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f web",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "db:apply-schema-compat": "powershell -ExecutionPolicy Bypass -File scripts/apply-schema-compat.ps1",
        "check:portal-nav": "node scripts/validate-portal-nav.mjs",
        "check:ai-workflows": "node scripts/verify-ai-workflows.mjs",
        "check:ai-workflows:optional": "node scripts/verify-ai-workflows.mjs --optional",
        "verify:bandwidth": "node scripts/verify-bandwidth.mjs",
        "verify:fhir": "node scripts/verify-fhir.mjs",
        "verify:developer-auth": "node scripts/verify-developer-auth.mjs",
        "verify:openapi-app-contract": "node scripts/verify-openapi-app-contract.mjs",
        "verify:webhooks": "node scripts/verify-webhooks.mjs",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "playwright test",
        "test:strict-degradation": "playwright test --project=chromium tests/strict-degradation-contracts.spec.ts",
        "test:reception-contracts": "playwright test --project=chromium tests/reception-api-contracts.spec.ts tests/reception-api-authenticated-shapes.spec.ts",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "load:test": "k6 run loadtests/api-load-test.js",
        "load:test:bot": "k6 run loadtests/bot-webhook-load-test.js",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@prisma/adapter-pg": "7.7.0",
        "@prisma/client": "^7.7.0",
        "@prisma/config": "^7.7.0",
        "@sentry/nextjs": "^10.48.0",
        "@supabase/auth-helpers-nextjs": "^0.10.0",
        "@supabase/supabase-js": "^2.39.7",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.36.2",
        "axios": "^1.15.0",
        "clsx": "^2.1.0",
        "dotenv": "^17.4.2",
        "framer-motion": "^12.38.0",
        "google-auth-library": "^10.6.2",
        "googleapis": "^171.4.0",
        "import-in-the-middle": "^3.0.1",
        "lucide-react": "^0.554.0",
        "next": "^16.2.3",
        "pg": "^8.20.0",
        "prisma": "^7.7.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.72.1",
        "react-markdown": "^10.1.0",
        "recharts": "^2.12.2",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.2.1",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.24",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "autoprefixer": "^10.4.18",
        "eslint": "^9.39.1",
        "eslint-config-next": "^16.2.3",
        "husky": "^9.0.11",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "js-yaml": "^4.1.1",
        "postcss": "^8.4.35",
        "require-in-the-middle": "^8.0.1",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.8.3",
        "undici": "^8.2.0"
    },
    "optionalDependencies": {
        "@next/swc-win32-x64-msvc": "16.2.3"
    }
}
