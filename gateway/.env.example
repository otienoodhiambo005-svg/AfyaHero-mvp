# AfyaHero Gateway - Environment Configuration
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your-secret-key-minimum-32-characters-long
DEBUG=true

# ── Supabase (REQUIRED) ────────────────────────────────────────────
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ─────────────────────────────────────────────────────
# Get from: Supabase Dashboard > Settings > Connection Pooler
# Format: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Redis (Optional) ────────────────────────────────────────────
# Set if you want Redis-backed rate limiting
# REDIS_URL=redis://localhost:6379/0

# ── AI Providers (Optional) ───────────────────────────────────────
# Free tier key already configured - add your own for higher limits
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...

# ── M-Pesa Daraja (Optional) ────────────────────────────────────
# MPESA_CONSUMER_KEY=your-key
# MPESA_CONSUMER_SECRET=your-secret
# MPESA_SHORTCODE=your-shortcode
# MPESA_PASSKEY=your-passkey
# MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa